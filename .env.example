# Copy to .env — `make run` loads it automatically.

# Default model when no selector choice is made. Any pydantic-ai model name,
# a litellm:<model> name (see below), or "offline" for the built-in composer.
#LLMCOMPOSER_MODEL=anthropic:claude-opus-5

# Models offered in the studio's selector, comma-separated. "offline" is
# always included even if omitted here.
#LLMCOMPOSER_MODELS=litellm:claude-opus,litellm:gpt-4o,litellm:glm-4.6,offline

# Direct Anthropic access (the default model).
#ANTHROPIC_API_KEY=sk-ant-...

# LiteLLM proxy: routes litellm:<model> names — one key for many providers.
#LITELLM_BASE_URL=http://localhost:4000
#LITELLM_API_KEY=sk-...

# Optional tracing.
#LOGFIRE_TOKEN=...
